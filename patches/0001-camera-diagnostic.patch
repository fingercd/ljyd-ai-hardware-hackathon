-    const uint32_t expect = s_cam.width * s_cam.height * 2;
+    static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    uint32_t hash = 2166136261u;
+    for (size_t i = 0; i < len; ++i) hash = (hash ^ data[i]) * 16777619u;
+    printf("\nCAMFRAME_BEGIN w=%" PRIu32 " h=%" PRIu32 " fourcc=%08" PRIx32 " bytes=%u fnv1a=%08" PRIx32 "\n",
+           s_cam.width, s_cam.height, s_cam.pixel_format, (unsigned)len, hash);
+    fflush(stdout);
+    for (size_t pos = 0; pos < len; pos += 96) {
+        char encoded[129];
+        size_t n = len - pos < 96 ? len - pos : 96;
+        size_t j = 0;
+        for (size_t i = 0; i < n; i += 3) {
+            uint32_t bits = (uint32_t)data[pos+i] << 16;
+            if (i+1 < n) bits |= (uint32_t)data[pos+i+1] << 8;
+            if (i+2 < n) bits |= data[pos+i+2];
+            encoded[j++] = alphabet[(bits >> 18) & 63];
+            encoded[j++] = alphabet[(bits >> 12) & 63];
+            encoded[j++] = i+1 < n ? alphabet[(bits >> 6) & 63] : '=';
+            encoded[j++] = i+2 < n ? alphabet[bits & 63] : '=';
+        }
+        encoded[j] = 0;
+        printf("CAMDATA:%s\n", encoded);
+        fflush(stdout);
+        vTaskDelay(pdMS_TO_TICKS(5));
+    }
+    printf("CAMFRAME_END\n");
+    fflush(stdout);
+}
